# OpenRouter key used by the Next.js API routes (/api/game/*)
OPENROUTER_API_KEY=
# Optional: chat model override (defaults to openai/gpt-5-nano)
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional: embeddings model override (defaults to openai/text-embedding-3-small)
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional, development only: realtime room server host.
# Defaults to "<page-hostname>:1999" (the `pnpm party:dev` worker).
# LAN note: when this is loopback and you open the app via a LAN IP,
# the client automatically rewrites to "<page-hostname>:1999".
# In production the room server is always served from the app's own origin.
# NEXT_PUBLIC_PARTY_HOST=127.0.0.1:1999
